---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { nav, site } from '../content/copy';

interface Props {
  title: string;
  tab?: 'home' | 'plan' | 'log' | 'photos' | 'chat';
}
const { title, tab } = Astro.props;
const tabs = [
  { key: 'home', href: '/', label: nav.home },
  { key: 'plan', href: '/plan', label: nav.plan },
  { key: 'log', href: '/log', label: nav.log },
  { key: 'photos', href: '/photos', label: nav.photos },
  { key: 'chat', href: '/chat', label: nav.chat },
] as const;
---
<BaseLayout title={title}>
  <header class="app-header">
    <a class="brand" href="/"><span class="brand-dot" aria-hidden="true"></span>{site.name}</a>
    <a class="icon-btn" href="/settings" aria-label={nav.settings}><Icon name="settings" /></a>
  </header>
  <slot />
  <div class="toast-region" aria-live="polite" slot="after" id="toasts"></div>
  <nav class="tabbar" aria-label="Main" slot="after">
    <ul>
      {tabs.map((t) => (
        <li>
          <a href={t.href} aria-current={tab === t.key ? 'page' : undefined} data-tab={t.key}>
            <Icon name={t.key} />
            <span>{t.label}</span>
            {t.key === 'chat' && <span class="badge" data-unread hidden></span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <script>
    import { get, getMe, post } from '../lib/api';
    import { tone } from '../content/copy';

    // Auth guard: every app page needs a session; api() redirects on 401.
    getMe().catch(() => {});

    // Unread badge: poll a tiny endpoint every 30 s while the tab is visible.
    const badge = document.querySelector<HTMLElement>('[data-unread]');
    const chatLink = document.querySelector<HTMLAnchorElement>('[data-tab="chat"]');
    const show = (n: number) => {
      if (!badge || !chatLink) return;
      badge.hidden = n === 0;
      badge.textContent = n > 9 ? '9+' : String(n);
      chatLink.setAttribute('aria-label', n ? `Chat, ${n} unread` : 'Chat');
    };
    let timer: ReturnType<typeof setTimeout> | undefined;
    const tick = async () => {
      clearTimeout(timer);
      if (document.visibilityState !== 'visible') return;
      try {
        const p = await get<{ unread: number }>('/api/pulse');
        show(p.unread);
        window.dispatchEvent(new CustomEvent('spotter:pulse', { detail: p }));
      } catch {}
      timer = setTimeout(tick, 30_000);
    };
    // Nudges from the partner appear as a toast on any page.
    const shown = new Set<string>();
    window.addEventListener('spotter:pulse', async (e) => {
      const nudges = (e as CustomEvent<{ nudges?: { id: string; kind: 'proud' | 'gym'; fromName: string }[] }>).detail.nudges ?? [];
      const fresh = nudges.filter((n) => !shown.has(n.id));
      if (!fresh.length) return;
      const me = await getMe();
      const tn = tone[me.pair?.type ?? 'friends'];
      const region = document.getElementById('toasts')!;
      for (const n of fresh) {
        shown.add(n.id);
        const el = document.createElement('div');
        el.className = 'toast';
        const text = document.createElement('span');
        text.textContent = tn.nudgeToast[n.kind](n.fromName);
        const btn = document.createElement('button');
        btn.className = 'btn btn--small';
        btn.type = 'button';
        btn.textContent = 'OK';
        btn.addEventListener('click', () => {
          el.remove();
          post('/api/nudges/seen').catch(() => {});
        });
        el.append(text, btn);
        region.append(el);
      }
    });
    document.addEventListener('visibilitychange', tick);
    window.addEventListener('spotter:unread', (e) => show((e as CustomEvent<number>).detail));
    tick();
  </script>
</BaseLayout>
