---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleButton from '../components/GoogleButton.astro';
import { auth, legal } from '../content/copy';
---
<BaseLayout title={auth.signIn} bare>
  <div class="auth-hero">
    <div class="mark" aria-hidden="true">💪</div>
    <h1>{auth.loginTitle}</h1>
    <p class="muted">{auth.loginLead}</p>
  </div>
  <div class="card stack">
    <p class="alert alert--ok" role="status" id="deleted"></p>
    <p class="alert alert--error" role="alert" id="error"></p>
    <GoogleButton id="google" />
    <p class="center muted small" style="margin:0">{auth.inviteOnlyNote}</p>
  </div>

  <form id="dev-login" class="card card--soft stack" hidden style="margin-top:16px">
    <h2>{auth.devTitle}</h2>
    <p class="small muted" style="margin:0">{auth.devLead}</p>
    <div class="field">
      <label for="dev-email">{auth.devEmail}</label>
      <input id="dev-email" name="email" type="email" value="alex@example.com" autocomplete="off" required />
    </div>
    <p class="alert alert--error" role="alert" id="dev-error"></p>
    <button class="btn btn--ghost" type="submit">{auth.devButton}</button>
  </form>
  <p class="legal-links small center"><a href="/privacy">{legal.privacy}</a> · <a href="/terms">{legal.terms}</a></p>
</BaseLayout>

<script>
  import { api, ApiError } from '../lib/api';
  import { auth } from '../content/copy';

  const params = new URLSearchParams(location.search);
  const next = params.get('next');
  const code = params.get('error');
  if (code) document.getElementById('error')!.textContent = auth.errors[code] ?? auth.errors.google;
  if (params.has('deleted')) document.getElementById('deleted')!.textContent = auth.deleted;
  // Carried through to the server, which validates it again.
  if (next) (document.getElementById('google') as HTMLAnchorElement).href = `/api/auth/google/start?next=${encodeURIComponent(next)}`;

  // Shown only when the API reports dev login enabled (DEV_LOGIN on localhost).
  const form = document.getElementById('dev-login') as HTMLFormElement;
  api('GET', '/api/auth/dev-login', undefined, { redirectOn401: false })
    .then(() => (form.hidden = false))
    .catch(() => {});
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const error = document.getElementById('dev-error')!;
    error.textContent = '';
    try {
      await api('POST', '/api/auth/dev-login', { email: new FormData(form).get('email') }, { redirectOn401: false });
      location.href = '/';
    } catch (err) {
      error.textContent = err instanceof ApiError ? err.message : String(err);
    }
  });
</script>
