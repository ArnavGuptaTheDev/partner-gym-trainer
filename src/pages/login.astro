---
import BaseLayout from '../layouts/BaseLayout.astro';
import { auth, site } from '../content/copy';
---
<BaseLayout title={auth.signIn} bare>
  <div class="auth-hero">
    <div class="mark" aria-hidden="true">💪</div>
    <h1>{auth.loginTitle}</h1>
    <p class="muted">{auth.loginLead}</p>
  </div>
  <form id="login" class="card stack" novalidate>
    <div class="field">
      <label for="email">{auth.email}</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="password">{auth.password}</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
    </div>
    <p class="alert alert--error" role="alert" id="error"></p>
    <button class="btn btn--block" type="submit">{auth.loginButton}</button>
  </form>
  <p class="center muted small" style="margin-top:20px">{auth.noAccount}</p>
  <p class="center small"><a href="/register">{site.name}: first-time setup</a></p>
</BaseLayout>

<script>
  import { api, ApiError } from '../lib/api';
  const form = document.getElementById('login') as HTMLFormElement;
  const error = document.getElementById('error')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.textContent = '';
    const fd = new FormData(form);
    const button = form.querySelector('button')!;
    button.disabled = true;
    try {
      await api('POST', '/api/auth/login', { email: fd.get('email'), password: fd.get('password') }, { redirectOn401: false });
      const next = new URLSearchParams(location.search).get('next');
      location.href = next && next.startsWith('/') && !next.startsWith('//') ? next : '/';
    } catch (err) {
      error.textContent = err instanceof ApiError ? err.message : String(err);
      button.disabled = false;
    }
  });
</script>
