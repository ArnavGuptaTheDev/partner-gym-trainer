---
import AppLayout from '../layouts/AppLayout.astro';
import PairingPanel from '../islands/PairingPanel';
import { auth, nav, settings } from '../content/copy';
import { DELETE_CONFIRMATION } from '../../shared/account';
---
<AppLayout title={nav.settings}>
  <h1>{nav.settings}</h1>
  <div class="stack">
    <PairingPanel client:load />
    <form class="card stack" id="profile" aria-labelledby="profile-h">
      <h2 id="profile-h">{settings.profileTitle}</h2>
      <div class="field">
        <label for="displayName">{settings.displayName}</label>
        <div class="row">
          <input id="displayName" name="displayName" maxlength="40" required autocomplete="nickname" />
          <button class="btn" type="submit">{settings.save}</button>
        </div>
      </div>
      <p class="alert alert--ok" role="status" id="profile-status"></p>
      <a href="/progress">{settings.progressLink} →</a>
    </form>
    <section class="card stack" aria-labelledby="theme-h">
      <h2 id="theme-h">{settings.themeTitle}</h2>
      <fieldset>
        <legend class="sr-only">{settings.themeTitle}</legend>
        <div class="segmented" id="theme">
          <label><input type="radio" name="theme" value="system" /><span>{settings.themeSystem}</span></label>
          <label><input type="radio" name="theme" value="light" /><span>{settings.themeLight}</span></label>
          <label><input type="radio" name="theme" value="dark" /><span>{settings.themeDark}</span></label>
        </div>
      </fieldset>
    </section>
    <a class="card spread" href="/admin" id="admin-link" hidden style="text-decoration:none;color:inherit">
      <strong>{nav.admin}</strong><span aria-hidden="true">→</span>
    </a>
    <button class="btn btn--ghost btn--block" type="button" id="logout">{auth.logout}</button>

    <section class="card stack danger-zone" aria-labelledby="delete-h">
      <h2 id="delete-h">{settings.deleteTitle}</h2>
      <p class="small muted" style="margin:0">{settings.deleteLead} <a href="/privacy#deletion">{settings.deleteLearnMore}</a></p>
      <button class="btn btn--danger" type="button" id="delete-start">{settings.deleteButton}</button>
      <form class="stack" id="delete-form" hidden>
        <p class="alert alert--error" style="margin:0">{settings.deleteFinalWarning}</p>
        <div class="field">
          <label for="delete-confirm">{settings.deleteTypeLabel(DELETE_CONFIRMATION)}</label>
          <input id="delete-confirm" autocomplete="off" autocapitalize="characters" spellcheck="false" />
        </div>
        <p class="alert alert--error" role="alert" id="delete-error"></p>
        <div class="row">
          <button class="btn btn--ghost" type="button" id="delete-cancel">{settings.deleteCancel}</button>
          <button class="btn btn--danger" type="submit" id="delete-submit" disabled>{settings.deleteFinal}</button>
        </div>
      </form>
    </section>
  </div>
</AppLayout>

<script>
  import { api, getMe, patch, post } from '../lib/api';
  import { DELETE_CONFIRMATION } from '../../shared/account';
  import { settings } from '../content/copy';

  const saved = (() => { try { return localStorage.getItem('spotter-theme'); } catch { return null; } })() ?? 'system';
  const radios = document.querySelectorAll<HTMLInputElement>('#theme input');
  radios.forEach((r) => {
    r.checked = r.value === saved;
    r.addEventListener('change', () => {
      const v = r.value;
      try { v === 'system' ? localStorage.removeItem('spotter-theme') : localStorage.setItem('spotter-theme', v); } catch {}
      if (v === 'system') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = v;
    });
  });

  const nameInput = document.getElementById('displayName') as HTMLInputElement;
  getMe().then((m) => {
    if (m.user.isSuper) document.getElementById('admin-link')!.hidden = false;
    nameInput.value = m.user.displayName;
  });
  document.getElementById('profile')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('profile-status')!;
    try {
      await patch('/api/u/me/profile', { displayName: nameInput.value, timezone: Intl.DateTimeFormat().resolvedOptions().timeZone });
      status.textContent = settings.saved;
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : String(err);
    }
  });

  document.getElementById('logout')!.addEventListener('click', async () => {
    await post('/api/auth/logout').catch(() => {});
    location.href = '/login';
  });

  // Account deletion: a confirm dialog, then typing the exact phrase.
  const delStart = document.getElementById('delete-start') as HTMLButtonElement;
  const delForm = document.getElementById('delete-form') as HTMLFormElement;
  const delInput = document.getElementById('delete-confirm') as HTMLInputElement;
  const delSubmit = document.getElementById('delete-submit') as HTMLButtonElement;
  const delError = document.getElementById('delete-error')!;
  delStart.addEventListener('click', () => {
    if (!confirm(settings.deleteConfirm1)) return;
    delStart.hidden = true;
    delForm.hidden = false;
    delInput.focus();
  });
  document.getElementById('delete-cancel')!.addEventListener('click', () => {
    delForm.hidden = true;
    delStart.hidden = false;
    delInput.value = '';
    delSubmit.disabled = true;
  });
  delInput.addEventListener('input', () => (delSubmit.disabled = delInput.value.trim() !== DELETE_CONFIRMATION));
  delForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    delError.textContent = '';
    delSubmit.disabled = true;
    try {
      await api('DELETE', '/api/account', { confirm: delInput.value.trim() });
      location.href = '/login?deleted=1';
    } catch (err) {
      delError.textContent = err instanceof Error ? err.message : String(err);
      delSubmit.disabled = false;
    }
  });
</script>
