---
import BaseLayout from '../layouts/BaseLayout.astro';
import { auth } from '../content/copy';
---
<BaseLayout title={auth.registerTitle} bare>
  <div class="auth-hero">
    <div class="mark" aria-hidden="true">🤝</div>
    <h1>{auth.registerTitle}</h1>
    <p class="muted" id="lead">{auth.registerLead}</p>
  </div>
  <p class="alert" id="invite-status" role="status"></p>
  <form id="register" class="card stack" novalidate>
    <div class="field">
      <label for="displayName">{auth.displayName}</label>
      <input id="displayName" name="displayName" autocomplete="nickname" maxlength="40" required />
    </div>
    <div class="field">
      <label for="email">{auth.email}</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="password">{auth.password}</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required aria-describedby="pw-hint" />
      <span class="hint" id="pw-hint">{auth.passwordHint}</span>
    </div>
    <p class="alert alert--error" role="alert" id="error"></p>
    <button class="btn btn--block" type="submit">{auth.registerButton}</button>
  </form>
  <p class="center small" style="margin-top:20px">{auth.haveAccount} <a href="/login">{auth.signIn}</a></p>
</BaseLayout>

<script>
  import { api, ApiError } from '../lib/api';
  import { auth } from '../content/copy';

  const form = document.getElementById('register') as HTMLFormElement;
  const error = document.getElementById('error')!;
  const status = document.getElementById('invite-status')!;
  const invite = new URLSearchParams(location.search).get('invite');

  if (!invite) {
    status.textContent = auth.inviteMissing;
  } else {
    status.textContent = auth.inviteChecking;
    api<{ valid: boolean }>('GET', `/api/invites/${encodeURIComponent(invite)}`)
      .then((r) => (status.textContent = r.valid ? '' : auth.inviteInvalid))
      .catch(() => (status.textContent = ''));
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.textContent = '';
    const fd = new FormData(form);
    const button = form.querySelector('button')!;
    button.disabled = true;
    try {
      await api('POST', '/api/auth/register', {
        email: fd.get('email'),
        password: fd.get('password'),
        displayName: fd.get('displayName'),
        inviteToken: invite ?? undefined,
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
      }, { redirectOn401: false });
      location.href = '/settings?welcome=1';
    } catch (err) {
      error.textContent = err instanceof ApiError ? err.message : String(err);
      button.disabled = false;
    }
  });
</script>
