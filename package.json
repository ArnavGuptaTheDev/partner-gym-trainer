{
  "name": "spotter",
  "version": "1.0.0",
  "description": "Invite-only partner gym trainer",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "astro dev",
    "dev:api": "wrangler dev --port 8788",
    "build": "astro build",
    "preview": "astro build && wrangler dev --port 8788",
    "typecheck": "tsc -p worker/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply spotter --local",
    "db:migrate:remote": "wrangler d1 migrations apply spotter --remote",
    "db:seed:local": "node scripts/seed.mjs",
    "deploy": "astro build && wrangler deploy"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.3.5",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "private": true
}
